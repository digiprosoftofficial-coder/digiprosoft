APP_NAME=DigiProSoft
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://www.digiprosoft.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Laravel Sail (Docker MySQL): ./vendor/bin/sail up -d
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=sail
# DB_PASSWORD=password
# APP_PORT=80
# WWWUSER=1000
# WWWGROUP=1000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# DigiProSoft site settings (see config/site.php)
# --------------------------------------------------------------------------
SITE_NAME=DigiProSoft
SITE_TAGLINE="Digital Product & Software Solution"
# Production: true + APP_ENV=production + APP_URL=https://www.digiprosoft.com
# Then submit /sitemap.xml in Google Search Console. AI agents: /llms.txt
SITE_FORCE_CANONICAL_HOST=false

SITE_EMAIL=digiprosoftofficial@gmail.com
SITE_PHONE=01851-392731
# International digits only (no +), e.g. 8801518421576
SITE_WHATSAPP=8801518421576
SITE_INQUIRY_RECIPIENT=digiprosoftofficial@gmail.com
SITE_ADDRESS_STREET=
SITE_ADDRESS_CITY=Dhaka
SITE_ADDRESS_REGION="Dhaka Division"
SITE_ADDRESS_POSTAL_CODE=
SITE_ADDRESS_COUNTRY=BD
# Shown on the contact page when set, e.g. "Saturday – Thursday, 10:00 AM – 7:00 PM (GMT+6)"
SITE_BUSINESS_HOURS=

SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=
SOCIAL_X=
SOCIAL_GITHUB=

SEO_DEFAULT_TITLE="DigiProSoft | Digital Products & Software Solutions"
SEO_TWITTER_HANDLE=

GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

SECURITY_CSP_ENABLED=true
SECURITY_HSTS_ENABLED=true
# "*" when behind a load balancer/CDN (Cloudflare, ALB), otherwise leave empty
TRUSTED_PROXIES=
